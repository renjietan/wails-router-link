# ============================================
# Wails 相关文件
# ============================================

# Wails 构建输出目录，存放最终的可执行文件
/bin/

# Wails 项目构建配置生成的目录
/build/

# Wails 自动生成的前端 bindings 文件，用于前端调用 Go 方法
/frontend/wailsjs/

# Wails 默认的前端构建输出目录
/frontend/dist/

# Wails 默认的 Node.js 前端依赖目录
/frontend/node_modules/

# Wails 的配置文件有时会包含本地路径或编译依赖
/wails.json

# ============================================
# Go 相关文件
# ============================================

# Go 编译出的二进制文件
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试二进制文件
*.test

# Go 覆盖率、性能分析等工具的输出文件
*.out
*.prof
*.log

# Go workspace 文件，属于本地开发环境配置
go.work
go.work.sum

# ============================================
# 前端相关文件
# ============================================

# 项目日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量文件
.env
.env.local
.env.*.local

# 编辑器目录，可能会记录本地路径
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# 项目中的特定文件 (Gin, SQLite, Swagger)
# ============================================

# SQLite 数据库文件，本地开发数据不应提交
*.db
*.sqlite
*.sqlite3
*-journal

# Swag (Swagger) 工具生成的文档目录，这些文件是根据代码注释自动生成的
/docs/

# Gin 框架在 Debug 模式下可能生成的日志
gin-bin

# ============================================
# 框架中定义的目录
# ============================================
/static/